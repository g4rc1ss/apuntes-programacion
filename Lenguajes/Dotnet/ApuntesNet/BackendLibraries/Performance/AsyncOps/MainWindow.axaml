<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AsyncOps.MainWindow"
        Title="AsyncOps">
    <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
        <Button Click="CpuTaskAsync" Content="CPU Operation"></Button>
        <Button Grid.Row="0" Grid.Column="1" Click="CpuBlockAsync" Content="CPU Blocking Operation"></Button>
        <Button Grid.Row="1" Click="IoAsync" Content="Input Output Operation"></Button>
        <Button Grid.Row="2" Click="EnumerableAsync" Content="Async Enumerable"></Button>
        <Button Grid.Row="3" Click="ExecuteCustomTaskAsync" Content="Custom Task"></Button>
    </Grid>
</Window>